[Unit]
Description=ngrok HTTPS tunnel for Inkless (example)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=simple
User=YOUR_LINUX_USERNAME
Environment=HOME=/home/YOUR_LINUX_USERNAME
WorkingDirectory=/home/YOUR_LINUX_USERNAME/DEMO_SERVER_INKLESSPROJECT
ExecStart=/usr/local/bin/ngrok http 127.0.0.1:8080 --url https://YOUR-NGROK-DOMAIN.ngrok-free.dev
Restart=always
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
